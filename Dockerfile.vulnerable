## Dockerfile.vulnerable — ví dụ bám theo lab "Policy as Code with Conftest".
## Cố ý vi phạm 4 chính sách an toàn tối thiểu của container Juice Shop.
FROM node:22-alpine
WORKDIR /juice-shop
COPY . .
RUN npm install --only=production
# VI PHẠM 1: không có USER non-root -> chạy bằng root (Least Privilege)
# VI PHẠM 2: mở cổng SSH 22 và DB 3306 (Attack Surface / RBAC)
EXPOSE 3000 22 3306
# VI PHẠM 3: thiếu nhãn provenance OCI (MFA/Provenance — không dùng LABEL mfa="true" tự khai)
# VI PHẠM 4: thiếu HEALTHCHECK (Observability/Logging)
CMD ["npm", "start"]
