# Hotfix image: image Juice Shop 20.2.0 gốc (ghim digest) + 2 route đã vá F01/F02.
# Build context là thư mục build/ (sinh bởi `npm run build:server`), nên không phải gửi cả repo vào Docker.
# Đạt bộ policy docker_security.rego (lab ConfTest): USER non-root, nhãn provenance, HEALTHCHECK.
FROM bkimminich/juice-shop@sha256:8739101ade29358abb5469ee66ae78e582c97ed0a5543a4ad102e5fa5193526b
ARG VCS_REF=fix-f01-f04
LABEL org.opencontainers.image.source="https://github.com/vuha211100-ui/juice-shop-sonarqube" \
      org.opencontainers.image.revision="${VCS_REF}"
COPY routes/login.js routes/basket.js /juice-shop/build/routes/
# F04: stage cuối khai báo rõ user không phải root (image gốc distroless, UID 65532)
USER 65532
# Observability: base image distroless không có shell, dùng node để tự kiểm tra
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=3 \
  CMD ["/nodejs/bin/node", "-e", "require('http').get('http://127.0.0.1:3000/',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"]
